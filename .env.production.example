NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"

# Secrets obligatoires à injecter par la plateforme de déploiement.
DB_PASSWORD="change-me"
DATABASE_URL="postgresql://progitpaie:change-me@postgres:5432/progitpaie?schema=public"
JWT_SECRET="generate-a-random-32-byte-secret"
ENCRYPTION_KEY="generate-a-separate-random-encryption-key"

POSTGRES_USER="progitpaie"
POSTGRES_DB="progitpaie"
REDIS_URL="redis://redis:6379"
JWT_EXPIRES_IN="7d"
NEXT_PUBLIC_APP_URL="https://example.invalid"
NEXT_PUBLIC_PROVISIONS_API_VERSION="legacy"
