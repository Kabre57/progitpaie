# ═══════════════════════════════════════════════════════════════════════════════
# PROGITPAIE — .gitignore (VPS Production)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Dépendances ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build Next.js ─────────────────────────────────────────────────────────────
/.next/
/out/
/build/
/.build/

# ── Secrets & Environnement ───────────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
.seed.env
production.env

# ── Tests & Couverture ────────────────────────────────────────────────────────
/coverage/
/test-results/
/playwright-report/

# ── Logs & Debug ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/

# ── Fichiers temporaires & OS ─────────────────────────────────────────────────
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
.vercel
tsconfig.tsbuildinfo

# ── Sauvegardes & Uploads ─────────────────────────────────────────────────────
/backups/
/uploads/

# ── Fichiers d'observation (VPS runtime) ────────────────────────────────────
observation-*/

# ── Outils de charge & Monitoring (non nécessaires sur VPS) ──────────────────
artillery-load-test.yml
load-test.js
grafana-dashboard.json
prometheus.yml

# ── Fichiers volumineux inutiles en prod ─────────────────────────────────────
*.xlsx
*.xls
copy_logipaie_rh24.xlsx
"©️ LOGIPAIE_RH24 .xls"

# ── Scripts de diagnostic locaux (pas besoin sur VPS) ────────────────────────
check_long_files.sh
secure-ports.sh
deploy-local.sh

# ── Dossier nginx (géré directement sur le VPS, pas via Git) ─────────────────
# nginx/  ← décommentez si votre config nginx est gérée manuellement sur le VPS

# ── Fichiers de configuration locale ──────────────────────────────────────────
*.local
*.dev
*.staging

# ── Fichiers d'IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Fichiers de cache ────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.next/cache/

# ── Rapports de sécurité ──────────────────────────────────────────────────────
security-report.html
vulnerability-report.json

# ── Fichiers de configuration personnelle ────────────────────────────────────
*.config.user.*
*.config.local.*