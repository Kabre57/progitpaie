{
  "name": "progitpaie",
  "version": "1.6.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "jest --runInBand",
    "test:reproducible": "pnpm prisma:generate && pnpm exec jest --runInBand",
    "test:e2e": "playwright test",
    "test:functional": "node --experimental-strip-types scripts/seed-functional-test.ts",
    "package:safe": "bash scripts/package-safe.sh",
    "prisma:generate": "pnpm exec prisma generate --schema=prisma/schema",
    "prisma:generate:ci": "pnpm exec prisma generate --schema=prisma/schema",
    "prisma:migrate": "pnpm exec prisma migrate dev --schema=prisma/schema",
    "prisma:studio": "pnpm exec prisma studio --schema=prisma/schema",
    "prisma:seed": "pnpm exec prisma db seed",
    "prisma:validate": "pnpm exec tsx prisma/scripts/validate.ts",
    "prisma:deploy": "pnpm exec prisma generate --schema=prisma/schema && pnpm exec prisma migrate deploy --schema=prisma/schema"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color-bits": "^1.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "exceljs": "4.4.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "idb": "^8.0.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.460.0",
    "motion": "^12.38.0",
    "next": "16.2.11",
    "nodemailer": "^9.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.62.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
