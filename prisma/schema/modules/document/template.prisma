/// Table des Notifications Système
model Notification {
  id        String           @id @default(cuid())
  companyId String
  userId    String // ID de l'employé destinataire
  title     String // Titre de la notification
  message   String // Contenu du message
  type      NotificationType @default(info) // Type (info, success, warning, error)
  isRead    Boolean          @default(false) // Statut de lecture
  link      String? // Lien de redirection

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
  @@index([companyId])
  @@map("notifications")
}
